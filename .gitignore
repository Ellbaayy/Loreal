# Dependencies
node_modules/

# Local secrets (Space secrets are set in the HF UI, never committed)
.env
.env.local

# Uploaded media (served from GitHub + jsDelivr, see src/storage.ts)
uploads/

# Photos stay out of git unless they are tracked on purpose: Hugging Face
# rejects plain binary blobs, so anything committed must go through LFS
# (.gitattributes).
*.png
*.jpg
