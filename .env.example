# Copy this file to `.env` for local development, then fill in your own key.
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed, pasted into a chat, or
# pushed to a repository. Only the variable NAMES belong in this template.
#
# On Hugging Face: Settings -> Variables and secrets -> New secret.
# On Vercel:       Project -> Settings -> Environment Variables.
KENARI_API_KEY=
KENARI_BASE_URL=https://kenari.id/v1
LORE_MODEL=deepseek-v4-1-flash
