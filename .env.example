# ============================================================
# LORE-AI Docker Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# ============================================================

# ============ APPLICATION SETTINGS ============
APP_NAME=LORE-AI
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost
APP_PORT=80

# ============ DATABASE CONFIGURATION ============
# DB_HOST should be "db" when using Docker Compose
# This is the service name, not localhost
DB_HOST=db
DB_PORT=3306
DB_NAME=lore_ai_db
DB_USER=root
DB_PASSWORD=root_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ============ API KEYS (EXTERNAL SERVICES) ============
# Get your API keys from:
# - Kenari: https://kenari.id
# - Groq: https://console.groq.com/keys
# - Hugging Face: https://huggingface.co/settings/tokens

# Kenari (https://kenari.id/v1) - PRIMARY AI provider
# OpenAI-compatible gateway. Model: deepseek-v4-1-flash (1M ctx, text+image, reasoning).
# Retrieve the available model list at any time: GET https://kenari.id/v1/models
KENARI_API_KEY=your_kenari_api_key_here
KENARI_BASE_URL=https://kenari.id/v1
LORE_MODEL=deepseek-v4-1-flash
# Reasoning effort for the primary model: low | high | max
LORE_REASONING_EFFORT=low

# Groq API - FALLBACK chat provider + audio transcription
# Default fallback chat model: openai/gpt-oss-120b
# (whisper-large-v3 handles voice input)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Inference API - FINAL fallback for chat and vision
# Get a free token at https://huggingface.co/settings/tokens
# Models used: Qwen/Qwen2.5-7B-Instruct-1M (chat) and
# meta-llama/Llama-3.2-11B-Vision-Instruct (vision)
HF_TOKEN=your_huggingface_token_here

# ============ FILE UPLOAD CONFIGURATION ============
UPLOAD_MAX_SIZE=5M
UPLOAD_DIR=uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# ============ SECURITY CONFIGURATION ============
# CORS_ORIGIN - Set to specific domain in production
# Examples:
#   Development: * (allow all)
#   Production: https://yourdomain.com
IMGBB_API_KEY=

CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ============ PHPMYADMIN CONFIGURATION ============
# Port to access PhpMyAdmin for database management
PHPMYADMIN_PORT=8081

# ============ LOGGING ============
LOG_LEVEL=debug
ERROR_LOG=/var/log/apache2/error.log
ACCESS_LOG=/var/log/apache2/access.log

# ============ PRODUCTION NOTES ============
# For production deployment, consider:
# - Change APP_ENV to "production"
# - Set APP_DEBUG to "false"
# - Use strong DB_PASSWORD (30+ characters)
# - Restrict CORS_ORIGIN to your domain
# - Use environment-specific secrets management
# - Enable HTTPS/SSL certificates
# - Add authentication to admin panel
# - Implement API rate limiting
