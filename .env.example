# ============================================================
# LORE-AI environment template
# Copy to .env and fill in the values. Never commit .env.
# Only the variables below are read by the code (src/**).
# ============================================================

# ============ SERVER ============
APP_PORT=7860

# ============ DATABASE ============
# Local development uses the XAMPP MySQL/MariaDB on 127.0.0.1:3306
# (see scripts/db.sh). XAMPP's root user has no password by default.
# Docker Compose overrides these for the app container (DB_HOST=db, user lore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lore_ai_db
DB_USER=root
DB_PASSWORD=
# Set to true only for a managed MySQL that requires TLS.
DB_SSL=false

# ============ ADMIN PANEL ============
# Bearer token for /api/admin/* (src/routes/admin.ts). Change before deploying.
ADMIN_PASSWORD=group3jaya

# ============ AI PROVIDERS ============
# Primary: Kenari (OpenAI-compatible). https://kenari.id
KENARI_API_KEY=
KENARI_BASE_URL=https://kenari.id/v1
LORE_MODEL=deepseek-v4-1-flash
LORE_REASONING_EFFORT=low

# Fallback chat + Whisper transcription. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Final fallback chat/vision. https://huggingface.co/settings/tokens
HF_TOKEN=

# ============ MEDIA STORAGE (GitHub + jsDelivr) ============
# Fine-grained token with "Contents: Read and write" on MEDIA_REPO.
# Leave empty to disable uploads; the app then keeps the existing image_url.
GITHUB_MEDIA_TOKEN=
MEDIA_REPO=Ellbaayy/lore-ai-media
MEDIA_BRANCH=main
MEDIA_CDN_BASE=https://cdn.jsdelivr.net/gh/Ellbaayy/lore-ai-media@main
